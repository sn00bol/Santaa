# General
DISCORD_BOT_API_KEY=YOUR_BOT_TOKEN
PFX=YOUR_BOT_PREFIX
OWNER_ID=YOUR_DISCORD_ID

# Slash command
SLASH_GUILD_ID= # Optional: use a server ID for near-instant command updates
SLASH_RESET=false # Set true for one startup to delete old slash commands and register the current ones

# Update settings
AUTO_UPDATE=false # Host-side Git updater only; disabled by default and always disabled in Docker
UPDATE_REPOSITORY= # Optional: Git repository URL used by the updater
UPDATE_BRANCH=main # The branch to pull updates from (default: main)
CHECK_INTERVAL=3600 # The interval in seconds to check for updates (default: 3600 seconds = 1 hour)

# Docker Compose settings
# Local build is the default. For GHCR production, set image to ghcr.io/meh2025/santaa:latest and pull policy to always.
SANTAA_IMAGE=santaa:sn00bol
SANTAA_PULL_POLICY=build
SANTAA_WATCHTOWER_ENABLED=false
SANTAA_UID=1000
SANTAA_GID=1000
SANTAA_MEMORY_LIMIT=1g
SANTAA_CPUS=1.0
